# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# FCM(@react-native-firebase) — use_frameworks 미사용 시 Firebase pod 을 static framework 로 링크
$RNFirebaseAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'codingpt' do
  config = use_native_modules!

  # FCM(@react-native-firebase) — Firebase 의 Swift pod(FirebaseCoreInternal 등)이 static 으로 링크되려면
  #  비모듈 C 의존(GoogleUtilities)에 module map 이 필요. static 라이브러리 유지하면서 modular header 만 켠다.
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Xcode 27 부터 배포 타깃 15.0 미만은 경고가 아니라 에러다 — 옛 타깃(9.0~13.0)을 박아 둔
    #  서드파티 Pod(AppAuth·GoogleSignIn·RevenueCat 등) 때문에 archive 가 실패한다. 앱과 같은 값으로 끌어올린다.
    installer.pods_project.targets.each do |t|
      t.build_configurations.each do |c|
        cur = c.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported if cur && cur.to_f < min_ios_version_supported.to_f
        # Xcode 27 clang 이 fmt 11 의 consteval 포맷 문자열(format-inl.h)을 "상수식 아님" 으로 거부한다.
        #  fmt 는 FMT_USE_CONSTEVAL 외부 정의를 안 받으므로, fmt 자체 컴파일만 C++17 로 내려 consteval 경로를 끈다.
        c.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17' if t.name == 'fmt'
      end
    end
    # Xcode 27 Swift 는 기본값 nil 인 옵셔널 var 를 memberwise init 에 넣어 합성한다 → RevenueCat 5.67 의
    #  PaywallColor 가 공개 init(stringRepresentation:) 와 겹쳐 "invalid redeclaration" 으로 컴파일 실패.
    #  _underlyingColor 는 designated init 에서만 대입되므로 let 으로 바꿔도 동작은 같다(기본값이 사라져 합성 충돌 제거).
    #  RevenueCat 이 고쳐진 버전으로 올리면 이 블록은 조용히 무동작이 된다(치환 대상 문자열이 없음).
    pc = File.join(installer.sandbox.root, 'RevenueCat/Sources/Paywalls/PaywallColor.swift')
    if File.exist?(pc)
      src = File.read(pc)
      patched = src.sub('fileprivate var _underlyingColor: (any Sendable)?', 'fileprivate let _underlyingColor: (any Sendable)?')
      if patched != src
        File.chmod(0644, pc)
        File.write(pc, patched)
      end
    end
  end
end
